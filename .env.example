# Supabase PostgreSQL Database URL
DATABASE_URL="postgresql://[USER]:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"

# Supabase Client Credentials
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR_SUPABASE_PROJECT_ID].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_[YOUR_ANON_KEY]"

# Cloudflare R2 Credentials
R2_ACCESS_KEY_ID="[YOUR_R2_ACCESS_KEY]"
R2_SECRET_ACCESS_KEY="[YOUR_R2_SECRET_KEY]"
R2_ENDPOINT="https://[YOUR_ACCOUNT_ID].r2.cloudflarestorage.com"
R2_BUCKET_NAME="[YOUR_BUCKET_NAME]"
NEXT_PUBLIC_R2_PUBLIC_URL="https://[YOUR_PUBLIC_R2_URL].r2.dev"

# Resend Email Configuration
# Option 1: Single API key
RESEND_API_KEY="re_123456789"
# Option 2: Multi-Key Pool (comma-separated for quota pooling and auto-failover)
# RESEND_API_KEYS="re_key1,re_key2,re_key3"
# Sender address (default: Semstack <onboarding@resend.dev>)
RESEND_FROM="Semstack <onboarding@resend.dev>"
# Public application URL for email CTAs & logo asset loading
APP_URL="https://semstack.vercel.app"
