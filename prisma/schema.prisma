generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String?
  role            String   @default("STUDENT") // STUDENT, SENIOR, ADMIN
  status          String   @default("PENDING") // PENDING, ACTIVE, REJECTED, GRADUATED
  avatar          String?
  createdAt       DateTime @default(now())

  // Profile fields collected at registration
  regNumber       String?  @unique             // Format: YYYY-CE-XX or YYYY-CE-XXX
  phone           String?
  section         String?                      // A, B, C, etc.
  semester        Int      @default(1)         // 1 to 8
  batchYear       Int?                         // Extracted from regNumber (e.g. 2024)
  heldBack        Boolean  @default(false)     // Re-take student flag (skips automatic batch advancement)
  rejectionReason String?

  notes               Note[]
  bookmarks           Bookmark[]
  contributorRequest  ContributorRequest?
  contentRequests     ContentRequest[]
}

model ContributorRequest {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  whyContribute      String
  semestersHaveNotes Int[]    // e.g. [1, 2]
  status             String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt          DateTime @default(now())
}

model AcademicPeriod {
  id        String   @id @default(cuid())
  name      String                          // e.g. "Fall 2026", "Spring 2027"
  startDate DateTime
  endDate   DateTime
  status    String   @default("UPCOMING")  // UPCOMING, ACTIVE, SUMMER_BREAK, ENDED
  createdAt DateTime @default(now())

  batchMaps BatchSemesterMap[]
}

model BatchSemesterMap {
  id         String         @id @default(cuid())
  batchYear  Int                            // e.g. 2023
  semester   Int                            // Semester number for this batch during this period
  periodId   String
  period     AcademicPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([periodId, batchYear])
}

model Subject {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  semester  Int
  createdAt DateTime @default(now())

  notes     Note[]
}

model Note {
  id          String   @id @default(cuid())
  title       String
  description String?
  fileUrl     String
  pages       Int
  size        String
  status      String   @default("PENDING") // PENDING, PUBLISHED, REJECTED
  tone        String   @default("bg-sage")
  downloads   Int      @default(0)
  orderIndex  Int      @default(0)
  category    String   @default("Notes") // Notes, Past Papers, Slides & Books, Solutions & Assignments
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id])

  bookmarks   Bookmark[]
}

model Bookmark {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([userId, noteId])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  imageUrl  String?
  audience  String   @default("ALL") // ALL, SEM_1, ADMIN, etc.
  createdAt DateTime @default(now())
}

model ContentRequest {
  id          String   @id @default(cuid())
  type        String   // "Missing Course / Subject", "Request Lecture Notes", "Past Papers & Solutions", "Report Broken File / Typo", "General Feedback"
  semester    Int?
  subject     String?
  message     String
  status      String   @default("PENDING") // PENDING, RESOLVED, DISMISSED
  adminNotes  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}


